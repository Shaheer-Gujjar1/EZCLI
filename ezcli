#!/usr/bin/env python3
"""EasyCLI (ezcli) - Terminal frontend wrapper for common Linux commands."""

import os
import sys

# Ensure local ezcli_app is in Python search path
repo_dir = os.path.dirname(os.path.abspath(__file__))
if repo_dir not in sys.path:
    sys.path.insert(0, repo_dir)

from ezcli_app.main import main

if __name__ == "__main__":
    main()
